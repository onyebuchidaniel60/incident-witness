{
  "name": "@incident-witness/demo-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Incident Witness local end-to-end demo harness",
  "type": "module",
  "scripts": {
    "demo": "tsx src/run-demo.ts",
    "seed:judge-demo": "npm run predemo && tsx src/seed-judge.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "predemo": "npm run build --workspace @incident-witness/protocol && npm run build --workspace @incident-witness/cli-verifier",
    "pretest:integration": "npm run predemo",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@incident-witness/db": "0.1.0",
    "@incident-witness/protocol": "0.1.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
