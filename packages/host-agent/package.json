{
  "name": "@incident-witness/host-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Incident Witness Linux x86_64 host agent",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "iw-agent": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build --workspace @incident-witness/protocol",
    "test": "vitest run --config vitest.config.ts",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@incident-witness/protocol": "0.1.0",
    "better-sqlite3": "13.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
