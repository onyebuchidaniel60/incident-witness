{
  "name": "@incident-witness/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build --workspace @incident-witness/protocol && npm run build --workspace @incident-witness/db",
    "test": "vitest run --config vitest.config.ts",
    "pretest:integration": "npm run build --workspace @incident-witness/protocol && npm run build --workspace @incident-witness/db",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@incident-witness/db": "0.1.0",
    "@incident-witness/protocol": "0.1.0",
    "dotenv": "18.0.9",
    "fastify": "5.12.7",
    "jose": "6.2.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
