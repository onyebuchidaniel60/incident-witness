# Incident Witness web — local example
#
# Copy the relevant variable names into the root `.env` used by the workspace.
# Never add secrets or production credentials to a browser-visible `NEXT_PUBLIC_*` value.
#
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
