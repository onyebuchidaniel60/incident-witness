# Incident Witness — local development template only.
# Blank values are intentionally not populated. Provision test/staging credentials separately.
# Never copy Production secrets into local development or Vercel Preview.

# Shared/local runtime
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:3000
# Optional public API origin returned to enrolling agents; defaults to http://localhost:PORT
IW_API_BASE_URL=http://localhost:4000

# Public browser configuration (safe to expose only these explicitly public values)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Fastify API — server-only
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
DATABASE_URL_IW_API=
IW_TOKEN_PEPPER=
IW_PLATFORM_SIGNING_PRIVATE_KEY=
IW_PLATFORM_KEY_ID=
IW_ALLOWED_WEB_ORIGINS=http://localhost:3000
IW_HEALTHCHECK_TOKEN=
IW_LOG_LEVEL=info
IW_BUNDLE_MAX_BYTES=10485760
IW_ENABLE_DEMO_SESSIONS=false

# Render/local probe worker — worker-only; never copy API root signing key here.
# Provision the platform_probe witness key once with `npm run db:provision-probe-key`
# before starting the worker; the runtime gets only this probe key + iw_worker DB URL.
DATABASE_URL_IW_WORKER=
IW_PLATFORM_PROBE_KEY_ID=
IW_PLATFORM_PROBE_PRIVATE_KEY=
IW_PROBE_POLL_INTERVAL_MS=1000
IW_PROBE_INTERVAL_SECONDS=15
IW_PROBE_TIMEOUT_MS=3000
IW_PROBE_CONCURRENCY=5
IW_PROBE_MAX_ATTEMPTS=5

# CI / migration only — never present in API or worker runtime
DATABASE_URL_MIGRATOR=

# Host-agent configuration is created by `iw-agent enroll` in ~/.config/incident-witness
# (directory 0700, files 0600). Never put host credentials, private keys, enrollment codes
# or device credentials in this web/API environment file.
